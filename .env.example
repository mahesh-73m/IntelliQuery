# Generate a secret with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Set APP_ENV=production to refuse the default SECRET_KEY.
# ---------- App ----------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Postgres (docker-compose reads these) ----------
POSTGRES_DB=intelliquery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
IQ_APP_PASSWORD=change-me-app
IQ_RO_PASSWORD=change-me-readonly

# ---------- Connection URLs (used when running the backend outside Docker) ----------
APP_DATABASE_URL=postgresql+psycopg://iq_app:change-me-app@localhost:5432/intelliquery
READONLY_DATABASE_URL=postgresql+psycopg://iq_readonly:change-me-readonly@localhost:5432/intelliquery

# ---------- Query safety ----------
QUERY_TIMEOUT_SECONDS=5
MAX_RESULT_ROWS=1000
MAX_CLARIFICATION_ROUNDS=3
RATE_LIMIT_PER_MINUTE=30

# ---------- LLM (set at least one key) ----------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
